# Environment variables for production deployment on Render

# Port for the server (Render assigns this automatically)
PORT=10000

# Database - Render provides a PostgreSQL, but we're using SQLite for now
DATABASE_URL="file:./dev.db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"

# Environment
NODE_ENV="production"
